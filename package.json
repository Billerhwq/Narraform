{
  "name": "narraform",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start:api": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node scripts/e2e-v1.mjs",
    "test:e2e:operations": "node scripts/e2e-content-operations.mjs",
    "test:e2e:topics": "node scripts/e2e-topics.mjs",
    "test:e2e:recent-delete": "node scripts/e2e-recent-delete.mjs",
    "test:e2e:expression-mode": "node scripts/e2e-expression-mode.mjs",
    "test:e2e:question-card": "node scripts/e2e-question-card.mjs",
    "test:e2e:strategy-error": "node scripts/e2e-strategy-error.mjs",
    "test:e2e:xhs-formatting": "node scripts/e2e-xhs-formatting-v4.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "AI-native content studio for creating platform-aware Chinese copy.",
  "dependencies": {
    "@ant-design/x": "^2.9.0",
    "@arco-design/web-react": "^2.66.16",
    "@tiptap/extension-placeholder": "^3.30.1",
    "@tiptap/markdown": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "antd": "^6.6.0",
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "mammoth": "^1.12.1",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-social-icons": "^6.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.1",
    "docx": "^9.7.1",
    "pdfkit": "^0.19.1",
    "playwright-core": "^1.55.0",
    "vite": "^8.2.1"
  }
}
